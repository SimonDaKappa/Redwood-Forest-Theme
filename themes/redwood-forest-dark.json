  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6a8372",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, tags, selectors",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other",
        "entity.name.tag",
        "entity.name.selector",
        "meta.selector"
      ],
      "settings": {
        "foreground": "#4d9375"
      }
    },
    {
      "name": "Titles: classes, functions, sections",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "entity.name.class",
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "meta.function-call",
        "entity.other.inherited-class",
        "support.class",
        "markup.heading",
        "meta.type.parameters",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#80a665"
      }
    },
    {
      "name": "Variables, params, template variables",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "variable.template-variable",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#c99076"
      }
    },
    {
      "name": "Attributes, properties, meta",
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.other.attribute-name",
        "meta.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#d9ab7c"
      }
    },
    {
      "name": "Types and built-ins",
      "scope": [
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.ts",
        "entity.name.namespace",
        "entity.name.type.namespace",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#5da994"
      }
    },
    {
      "name": "Strings, regexp, symbols",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "constant.other.symbol",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a3b39a"
      }
    },
    {
      "name": "Numbers and literals",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#6394bf"
      }
    },
    {
      "name": "Punctuation / default",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name" : "Markup Inline",
      "scope" : [
        "markup.inline.raw",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#a3b39a",
      },
    },
    {
      "name" : "Markup Bold",
      "scope" : [
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#d9ab7c",
        "fontStyle": "bold"
      },
    },
    {
      "name" : "Markup Italic",
      "scope" : [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d9ab7c",
        "fontStyle": "italic"
      },
    }
  ],
  "semanticHighlighting": false,
  "semanticTokenColors": {
    "class": "#80a665",
    "class.defaultLibrary": "#80a665",
    "interface": "#80a665",
    "interface.defaultLibrary": "#80a665",
    "struct": "#5da994",
    "enum": "#80a665",
    "type": "#5da994",
    "type.defaultLibrary": "#80a665",
    "typeParameter": "#d4d4d4",
    "namespace": "#5da994",
    "function": "#80a665",
    "function.declaration": "#80a665",
    "function.defaultLibrary": "#80a665",
    "method": "#80a665",
    "method.declaration": "#80a665",
    "method.defaultLibrary": "#80a665",
    "macro": "#6394BF",
    "property": "#d9ab7c",
    "property.declaration": "#d9ab7c",
    "property.readonly": "#d9ab7c",
    "property.defaultLibrary": "#d9ab7c",
    "parameter": "#c99076",
    "parameter.declaration": "#c99076",
    "variable.parameter": "#c99076",
    "enumMember": "#6394bf",
    "decorator": "#d9ab7c"
  }
}